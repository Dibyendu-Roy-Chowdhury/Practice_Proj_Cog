# Multi-stage build for React frontend
FROM node:18-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
ARG REACT_APP_API_URL=""
ARG REACT_APP_VERIFORGE_API_URL=""
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_VERIFORGE_API_URL=$REACT_APP_VERIFORGE_API_URL
ENV CI=false
RUN npm run build

# Production stage — non-root nginx (F-027)
# nginxinc/nginx-unprivileged runs as the nginx user (UID 101) by default,
# satisfying scanner USER-directive requirements without CAP_NET_BIND_SERVICE.
# Listens on port 8080 (non-privileged); the k8s Service maps 80 → 8080.
FROM nginxinc/nginx-unprivileged:alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
