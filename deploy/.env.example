# ─────────────────────────────────────────────────────────────────
# VeriForge Ops — Backend Environment Variables
# Copy this file to /opt/veriforge-ops/server/.env on the EC2 instance.
# Never commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
# MongoDB connection string.
# For local MongoDB with auth enabled (recommended):
#   mongodb://<db-user>:<db-password>@127.0.0.1:27017/veriforgeops?authSource=veriforgeops
# For local MongoDB without auth (dev/test only):
#   mongodb://127.0.0.1:27017/veriforgeops
MONGO_URI=mongodb://veriforge_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:27017/veriforgeops?authSource=veriforgeops

# ── Authentication ────────────────────────────────────────────────
# JWT signing secret. MUST be a cryptographically random string (64+ chars).
# Generate with: openssl rand -hex 64
# WARNING: The dev placeholder (veriforge_jwt_secret_change_in_production_2026)
#          is publicly known — never use it in production.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_64

# JWT token lifetime. Format: https://github.com/vercel/ms
JWT_EXPIRES_IN=24h

# ── Server ────────────────────────────────────────────────────────
# Port the Express API listens on. Keep at 4000 (internal; nginx proxies it).
PORT=4000

# Node environment. Set to 'production' to suppress stack traces in error responses.
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# Use your EC2 public IP (port 80 served by nginx).
# Example: http://1.2.3.4  or  https://yourdomain.com
ALLOWED_ORIGINS=http://<EC2-PUBLIC-IP>
